# Optional — only needed for synthesized answers and quiz mode. Without any key,
# Learn mode shows cited passages and Quiz mode is unavailable.
# Free Groq key: console.groq.com
GROQ_API_KEY=your_groq_api_key

# Optional xAI Grok fallback (console.x.ai) — used when Groq rate-limits
# XAI_API_KEY=your_xai_api_key
# XAI_MODEL=grok-4-1-fast-non-reasoning

# Primary Groq model (others are tried automatically on rate-limit / token errors)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=high            # low | medium | high (gpt-oss/qwen only)

# Custom fallback order (default: primary Groq → llama-3.3-70b → gpt-oss-20b → qwen3 → xAI)
# LLM_FALLBACK=groq:openai/gpt-oss-120b,groq:llama-3.3-70b-versatile,xai:grok-4-1-fast-non-reasoning

# Trim book excerpts sent to the LLM if requests are still too large
# LLM_CONTEXT_CHARS=10000
